        <!-- Code Health Monitor project services -->
        <projectService
                serviceImplementation="com.llamatik.teammate.codehealth.CodeHealthInsightStore"/>
        <projectService
                serviceImplementation="com.llamatik.teammate.codehealth.BackgroundInsightAnalyzer"/>
        <projectService
                serviceImplementation="com.llamatik.teammate.codehealth.CodeHealthScheduler"/>
        <projectService
                serviceImplementation="com.llamatik.teammate.codehealth.RegressionRiskAnalyzer"/>
        <projectService
                serviceImplementation="com.llamatik.teammate.codehealth.WatchedAreaService"/>
        <projectService
                serviceImplementation="com.llamatik.teammate.codehealth.CurrentWorkContextService"/>
        <projectService
                serviceImplementation="com.llamatik.teammate.codehealth.BeforeCommitAssistant"/>
        <projectService
                serviceImplementation="com.llamatik.teammate.codehealth.RefactorOpportunityAnalyzer"/>
        <projectService
                serviceImplementation="com.llamatik.teammate.codehealth.CodeHealthNotificationService"/>

        <!-- Settings page -->
        <applicationConfigurable
                displayName="Llamatik Code"
                id="llamatik.code.settings"
                instance="com.llamatik.teammate.settings.LlamatikSettingsConfigurable"/>
        <applicationConfigurable
                displayName="Inference"
                id="llamatik.code.settings.inference"
                parentId="llamatik.code.settings"
                instance="com.llamatik.teammate.settings.InferenceSettingsConfigurable"/>
        <applicationConfigurable
                displayName="MCP Servers"
                id="llamatik.code.settings.mcp"
                parentId="llamatik.code.settings"
                instance="com.llamatik.teammate.mcp.McpSettingsConfigurable"/>
        <applicationConfigurable
                displayName="External Knowledge"
                id="llamatik.code.settings.external"
                parentId="llamatik.code.settings"
                instance="com.llamatik.teammate.settings.ExternalKnowledgeSettingsConfigurable"/>
        <applicationConfigurable
                displayName="Code Health Monitor"
                id="llamatik.code.settings.codehealth"
                parentId="llamatik.code.settings"
