                instance="com.llamatik.teammate.settings.AutonomousDevSettingsConfigurable"/>
        <applicationConfigurable
                displayName="Statistics"
                id="llamatik.code.settings.statistics"
                parentId="llamatik.code.settings"
                instance="com.llamatik.teammate.settings.StatisticsSettingsConfigurable"/>

        <!-- Enterprise Pair Programmer project service -->
        <projectService
                serviceImplementation="com.llamatik.teammate.workflows.enterprise.EnterprisePairProgrammerService"/>

        <!-- Inline completion service -->
        <applicationService
                serviceImplementation="com.llamatik.teammate.completion.LlamatikInlineCompletionService"/>

        <!-- Review / feedback -->
        <applicationService
                serviceImplementation="com.llamatik.teammate.review.ReviewPromptService"/>

        <!-- Analytics & Statistics -->
        <applicationService
                serviceImplementation="com.llamatik.teammate.analytics.GenerationStatsService"/>
        <applicationService
                serviceImplementation="com.llamatik.teammate.analytics.TrackingService"/>

    </extensions>

    <actions>
        <!-- Autonomous Local Development action group -->
        <group id="LlamatikCode.AutonomousLocalDevelopment"
               text="Autonomous Local Development"
               description="Run local coding missions with Llamatik Code"
               popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </group>
        <action id="LlamatikCode.EnterprisePairProgrammer"
                class="com.llamatik.teammate.actions.EnterprisePairProgrammerAction"
                text="Offline Enterprise Pair Programmer"
                description="Start an Offline Enterprise Pair Programmer session">
            <add-to-group group-id="LlamatikCode.AutonomousLocalDevelopment" anchor="first"/>
        </action>
        <action id="LlamatikCode.EnterpriseReviewCurrentChanges"
                class="com.llamatik.teammate.actions.EnterpriseReviewCurrentChangesAction"
                text="Review Current Changes Before Commit"
                description="Review current git changes before committing">
            <add-to-group group-id="LlamatikCode.AutonomousLocalDevelopment" anchor="last"/>
        </action>
        <action id="LlamatikCode.EnterpriseFixBuildFailure"
                class="com.llamatik.teammate.actions.EnterpriseFixBuildFailureAction"
                text="Repair Build Failure"
                description="Repair the current build failure with enterprise mission mode">
            <add-to-group group-id="LlamatikCode.AutonomousLocalDevelopment" anchor="last"/>
        </action>
        <action id="LlamatikCode.EnterpriseGenerateTests"
                class="com.llamatik.teammate.actions.EnterpriseGenerateTestsAction"
                text="Generate Tests for This File"
                description="Generate tests using enterprise mission mode">
            <add-to-group group-id="LlamatikCode.AutonomousLocalDevelopment" anchor="last"/>
        </action>
        <action id="LlamatikCode.EnterpriseExplainArchitecture"
                class="com.llamatik.teammate.actions.EnterpriseExplainArchitectureAction"
                text="Explain Module Architecture"
                description="Explain the architecture of this module">
            <add-to-group group-id="LlamatikCode.AutonomousLocalDevelopment" anchor="last"/>
        </action>
        <action id="LlamatikCode.EnterpriseSafeRefactor"
                class="com.llamatik.teammate.actions.EnterpriseSafeRefactorAction"
                text="Safely Refactor Current File"
                description="Safely refactor with enterprise mission mode">
            <add-to-group group-id="LlamatikCode.AutonomousLocalDevelopment" anchor="last"/>
        </action>
        <action id="LlamatikCode.EnterpriseImplementFeature"
                class="com.llamatik.teammate.actions.EnterpriseImplementFeatureAction"
                text="Implement a Feature Locally"
                description="Implement a feature using enterprise mission mode">
            <add-to-group group-id="LlamatikCode.AutonomousLocalDevelopment" anchor="last"/>
        </action>

        <action id="LlamatikCode.AskAboutSelection"
                class="com.llamatik.teammate.actions.AskAboutSelectionAction"
                text="Ask Llamatik About Selection"
                description="Ask Llamatik Code about the current selection">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="LlamatikCode.ExplainFile"
                class="com.llamatik.teammate.actions.ExplainFileAction"
                text="Explain This File"
                description="Explain the current file with Llamatik Code">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="LlamatikCode.RefactorSelection"
                class="com.llamatik.teammate.actions.RefactorSelectionAction"
                text="Refactor Selection"
                description="Refactor selected code with Llamatik Code">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="LlamatikCode.FixSelectedCode"
                class="com.llamatik.teammate.actions.FixSelectedCodeAction"
                text="Fix Selected Code"
                description="Fix selected code with Llamatik Code">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="LlamatikCode.GenerateTests"
                class="com.llamatik.teammate.actions.GenerateTestsAction"
                text="Generate Tests for File"
                description="Generate tests using Llamatik Code">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="LlamatikCode.AddDocumentation"
                class="com.llamatik.teammate.actions.AddDocumentationAction"
                text="Add Documentation"
                description="Add documentation using Llamatik Code">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="LlamatikCode.EditWithPrompt"
                class="com.llamatik.teammate.actions.EditWithPromptAction"
                text="Edit with Prompt"
                description="Open Llamatik Code with an edit prompt">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="LlamatikCode.ExplainFailingBuild"
                class="com.llamatik.teammate.actions.ExplainFailingBuildAction"
                text="Explain Failing Build"
                description="Explain the last build failure with Llamatik Code">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="LlamatikCode.RunDiagnostics"
                class="com.llamatik.teammate.actions.RunDiagnosticsAction"
                text="Run Llamatik Diagnostics"
                description="Run plugin self-diagnostics and show results">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="LlamatikCode.ExplainCurrentChanges"
                class="com.llamatik.teammate.actions.ExplainCurrentChangesAction"
                text="Explain Current Git Changes"
                description="Ask Llamatik Code to explain current git changes and suggest a commit message">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="LlamatikCode.SearchDocsWeb"
                class="com.llamatik.teammate.actions.SearchDocsWebAction"
                text="Search Docs &amp; Web"
                description="Search documentation and web for the selected text or a query">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>

