<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.llamatik.teammate.LlamatikTeammate</id>
    <name>Llamatik Code</name>
    <vendor url="https://www.llamatik.com">Llamatik AI</vendor>
    <description><![CDATA[
        <p><b>Llamatik Code</b> is a local-first AI coding assistant for IntelliJ-based IDEs, designed to help you understand, modify, and generate code directly inside your project.</p>

        <p>Built for developers who value <b>privacy, performance, and control</b>, Llamatik Code runs AI models locally on your machine and provides an agent-based workflow similar to tools like Claude Code or Cursor—without relying on the cloud.</p>

        <br/>

        <p><b>🚀 Key Features</b></p>
        <ul>
            <li><b>Project-aware chat</b> – Ask questions about your codebase with persistent, multi-chat support</li>
            <li><b>Local AI models</b> – Run models fully offline, keeping your code on your machine</li>
            <li><b>AI agent for code editing</b> – Generate and modify code using natural language with safe diff previews</li>
            <li><b>Context-aware assistance</b> – Understands the current file, selection, and project structure</li>
            <li><b>Multi-file workflows</b> – Perform coordinated changes across multiple files (Pro)</li>
        </ul>

        <br/>

        <p><b>🔒 Privacy-first</b><br/>
        Your code is processed locally by default. No data is sent to external servers unless explicitly configured.</p>

        <br/>

        <p><b>⚡ Who is it for?</b></p>
        <ul>
            <li>Developers who want a <b>local alternative to cloud AI tools</b></li>
            <li>Teams working with <b>private or sensitive codebases</b></li>
            <li>Power users looking for <b>agent-based workflows inside IntelliJ</b></li>
        </ul>

        <br/>

        <p><b>💡 Free & Pro</b><br/>
        Llamatik Code includes a free tier for everyday coding assistance, with advanced capabilities such as multi-file agent workflows available in Pro.</p>

        <br/>

        <p>Learn more: <a href="https://www.llamatik.com">https://www.llamatik.com</a></p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends optionalId="kotlin">org.jetbrains.kotlin</depends>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">

        <!-- Tool window -->
        <toolWindow
                id="Llamatik Code"
                anchor="right"
                secondary="false"
                factoryClass="com.llamatik.teammate.ui.toolwindow.LlamatikToolWindowFactory"
                icon="icons/llamatik.svg"/>

        <!-- Application-level services -->
        <applicationService
                serviceImplementation="com.llamatik.teammate.settings.LlamatikAppSettings"/>
        <applicationService
                serviceImplementation="com.llamatik.teammate.settings.DownloadedModelService"/>
        <applicationService
                serviceImplementation="com.llamatik.teammate.llamatik.LlamatikBackendService"/>
        <applicationService
                serviceImplementation="com.llamatik.teammate.licensing.TrialService"/>
        <applicationService
                serviceImplementation="com.llamatik.teammate.infrastructure.ModelDownloadManager"/>
        <applicationService
                serviceImplementation="com.llamatik.teammate.infrastructure.ModelRuntimeTracker"/>

        <!-- Skills -->
        <applicationService
                serviceImplementation="com.llamatik.teammate.skills.SkillService"/>

        <!-- Project-level services -->
        <projectService
                serviceImplementation="com.llamatik.teammate.persistence.LlamatikProjectState"/>
        <projectService
                serviceImplementation="com.llamatik.teammate.persistence.ChatSessionStore"/>
        <projectService
                serviceImplementation="com.llamatik.teammate.agent.AgentOrchestrator"/>
        <projectService
                serviceImplementation="com.llamatik.teammate.tools.ToolRegistry"/>
        <projectService
                serviceImplementation="com.llamatik.teammate.diff.DiffPreviewService"/>
        <projectService
                serviceImplementation="com.llamatik.teammate.agent.BuildVerificationService"/>
        <projectService
                serviceImplementation="com.llamatik.teammate.context.ProjectIndexingState"/>

        <!-- Settings page -->
        <applicationConfigurable
                displayName="Llamatik Code"
                id="llamatik.code.settings"
                instance="com.llamatik.teammate.settings.LlamatikSettingsConfigurable"/>
        <applicationConfigurable
                displayName="Inference"
                id="llamatik.code.settings.inference"
                parentId="llamatik.code.settings"
                instance="com.llamatik.teammate.settings.InferenceSettingsConfigurable"/>

    </extensions>

    <actions>
        <action id="LlamatikCode.AskAboutSelection"
                class="com.llamatik.teammate.actions.AskAboutSelectionAction"
                text="Ask Llamatik About Selection"
                description="Ask Llamatik Code about the current selection">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="LlamatikCode.ExplainFile"
                class="com.llamatik.teammate.actions.ExplainFileAction"
                text="Explain This File"
                description="Explain the current file with Llamatik Code">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="LlamatikCode.RefactorSelection"
                class="com.llamatik.teammate.actions.RefactorSelectionAction"
                text="Refactor Selection"
                description="Refactor selected code with Llamatik Code">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="LlamatikCode.FixSelectedCode"
                class="com.llamatik.teammate.actions.FixSelectedCodeAction"
                text="Fix Selected Code"
                description="Fix selected code with Llamatik Code">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="LlamatikCode.GenerateTests"
                class="com.llamatik.teammate.actions.GenerateTestsAction"
                text="Generate Tests for File"
                description="Generate tests using Llamatik Code">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="LlamatikCode.AddDocumentation"
                class="com.llamatik.teammate.actions.AddDocumentationAction"
                text="Add Documentation"
                description="Add documentation using Llamatik Code">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="LlamatikCode.EditWithPrompt"
                class="com.llamatik.teammate.actions.EditWithPromptAction"
                text="Edit with Prompt"
                description="Open Llamatik Code with an edit prompt">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
